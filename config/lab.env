# shellcheck shell=bash disable=SC2034
# Central configuration for the lab scripts.
# Every value can be overridden by exporting it before running a script.

DEVSTACK_DIR="${DEVSTACK_DIR:-/opt/stack/devstack}"

# --- Keystone ---------------------------------------------------------------
LAB_PROJECT="${LAB_PROJECT:-lab-project}"
LAB_USER="${LAB_USER:-labuser}"            # role: member
LAB_READER="${LAB_READER:-labreader}"      # role: reader
LAB_PASSWORD="${LAB_PASSWORD:-LabUser-2026-Change-Me}"   # lab use only

# --- Glance -----------------------------------------------------------------
CIRROS_VERSION="${CIRROS_VERSION:-0.6.2}"
CIRROS_IMAGE="cirros-${CIRROS_VERSION}"
UBUNTU_IMAGE="${UBUNTU_IMAGE:-ubuntu-24.04}"

# --- Nova -------------------------------------------------------------------
FLAVOR_NANO="lab.nano"       # 1 vCPU / 256 MB / 1 GB
FLAVOR_SMALL="lab.small"     # 1 vCPU / 1 GB   / 10 GB
FLAVOR_MEDIUM="lab.medium"   # 2 vCPU / 2 GB   / 20 GB
LAB_KEYPAIR="${LAB_KEYPAIR:-lab-key}"
SSH_KEY="${SSH_KEY:-$HOME/.ssh/lab-key}"
VM1="lab-vm1"
VM_ISO="lab-vm-isolated"

# --- Neutron ----------------------------------------------------------------
EXTERNAL_NET="${EXTERNAL_NET:-public}"     # created by DevStack
LAB_NET="lab-net"
LAB_SUBNET="lab-subnet"
LAB_SUBNET_CIDR="192.168.10.0/24"
ISO_NET="lab-isolated-net"
ISO_SUBNET="lab-isolated-subnet"
ISO_SUBNET_CIDR="192.168.20.0/24"
LAB_ROUTER="lab-router"
SG_SSH="lab-sg-ssh-icmp"
SG_WEB="lab-sg-web"

# --- Cinder -----------------------------------------------------------------
VOL1="lab-vol1"
SNAP1="lab-vol1-snap1"
VOL_RESTORED="lab-vol1-restored"
